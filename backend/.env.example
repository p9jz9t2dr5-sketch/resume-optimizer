# ===== 复制为 .env（Docker）或 .env.local（本地 SQLite）后填写 =====

# 数据库：Docker 用 PostgreSQL；本地无 Docker 用 SQLite
DATABASE_URL=postgresql+asyncpg://resume_user:resume_pass@db:5432/resume_optimizer
# DATABASE_URL=sqlite+aiosqlite:///./local_dev.db   # 本地开发
REDIS_URL=redis://redis:6379/0
# REDIS_URL=                                        # 本地开发（禁用配额 Redis）

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI（DeepSeek，OpenAI 兼容协议）
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_FAST_MODEL=deepseek-chat
AI_PREMIUM_MODEL=deepseek-chat

CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
FREE_DAILY_MESSAGE_LIMIT=20
